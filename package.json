{
  "name": "cats-runtime",
  "version": "0.1.0",
  "description": "Unified runtime for subscription CLIs and future API backends.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "cats-runtime": "./dist/index.js"
  },
  "files": [
    "dist",
    "public",
    "config/providers.yaml.example",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "prepack": "npm run build",
    "test": "npm run build && vitest run --pool=threads --poolOptions.threads.singleThread",
    "test:watch": "vitest --pool=threads --poolOptions.threads.singleThread",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "cats",
    "runtime",
    "gateway",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "hono": "^4.7.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
