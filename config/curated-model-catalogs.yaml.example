schema_version: 1

# Draft curator-facing model catalog input.
#
# Purpose:
# - Keep this file human-writable.
# - Fill in only the labels you can actually read from the CLI or UI.
# - Do not translate values into runtime/internal forms.
#
# Runtime normalization is intentionally a later cats-runtime responsibility.
# Inheritance rules:
# - model with no `options` key inherits shared_options in scope
# - use `options: []` to say a model has no options
# - provider shared_options override same-named catalog shared_options
#
# Provenance is per-catalog and no longer uniform - read each entry's `notes`.
# Every catalog carries a `version` and `last_updated`; `last_updated` means the
# entry was revisited on that date, NOT that every model below was re-read. When
# only part of an entry could be re-verified, the notes say which part and why.
#
# Seed data was originally backfilled from local CLI versions observed on
# 2026-04-08 plus the then-current cats-runtime static/advanced baselines.
#
# 2026-08-26 refresh: Antigravity, Codex, and Cursor are live CLI enumerations
# (`agy models`, `codex debug models`, `cursor-agent models`). Copilot, Kilo,
# Kiro, and Junie had their versions re-probed but not their model lists - those
# CLIs either gate the list behind an account, expose it only in an interactive
# picker, or publish a different artifact than the picker shows. Claude was left
# untouched and is still the 2026-04-17 entry - it is known stale (2.1.112 vs
# 2.1.246 installed, and the picker has since gained Fable 5 and Opus Plan Mode).
#
# Treat this file as a starting point to correct, trim, or expand.

catalogs:
  - cli: Claude
    version: 2.1.112
    last_updated: 2026-04-17
    notes:
      - "Source: claude /model picker and /effort output"
    models:
      - name: Opus
        label: Opus 4.7 with 1M context
        notes:
          - Most capable for complex work
        default: true
        context: 1000000
        options:
          - name: Effort
            values:
              - name: Low
                notes:
                  - "Quick, straightforward implementation with minimal overhead"
              - name: Medium
                notes:
                  - "Balanced approach with standard implementation and testing"
              - name: High
                notes:
                  - "Comprehensive implementation with extensive testing and documentation"
              - name: xHigh
                notes:
                  - "Deeper reasoning than high, just below maximum"
              - name: Max
                notes:
                  - "Maximum capability with deepest reasoning"
            default: xHigh

      - name: Sonnet
        label: Sonnet 4.6
        notes:
          - Best for everyday tasks
        options:
          - name: Effort
            values: [Low, Medium, High, Max]
            default: Medium

      - name: Haiku
        label: Haiku 4.5
        notes:
          - Fastest for quick answers
        options: []

  - cli: Codex
    version: 0.149.1
    last_updated: 2026-08-26
    notes:
      - "Source: refreshed `codex debug models` output from an authenticated Codex CLI"
      - "Only models with `visibility: list` are included; hidden internal models are omitted"
      - "Context values reflect the Codex CLI catalog and may differ from OpenAI API limits"
    shared_options:
      - name: Reasoning Level
        values:
          - name: Low
            notes:
              - "Fast responses with lighter reasoning"
          - name: Medium
            notes:
              - "Balances speed and reasoning depth for everyday tasks"
          - name: High
            notes:
              - "Greater reasoning depth for complex problems"
          - name: Extra high
            notes:
              - "Extra high reasoning depth for complex problems"
          - name: Max
            notes:
              - "Maximum reasoning depth for the hardest problems"
          - name: Ultra
            notes:
              - "Maximum reasoning with automatic task delegation"
        default: Medium
    models:
      - name: gpt-5.6-sol
        label: GPT-5.6-Sol
        notes:
          - "Latest frontier agentic coding model."
        default: true
        context: 272000
        options:
          - name: Reasoning Level
            default: Low

      - name: gpt-5.6-terra
        label: GPT-5.6-Terra
        notes:
          - "Balanced agentic coding model for everyday work."
        context: 272000

      - name: gpt-5.6-luna
        label: GPT-5.6-Luna
        notes:
          - "Fast and affordable agentic coding model."
        context: 272000
        options:
          - name: Reasoning Level
            values: [Low, Medium, High, Extra high, Max]
            default: Medium

      - name: gpt-5.5
        label: GPT-5.5
        notes:
          - "Frontier model for complex coding, research, and real-world work."
        context: 272000
        options:
          - name: Reasoning Level
            values: [Low, Medium, High, Extra high]
            default: Medium

      - name: gpt-5.4
        label: GPT-5.4
        notes:
          - "Strong model for everyday coding."
        context: 272000
        options:
          - name: Reasoning Level
            values: [Low, Medium, High, Extra high]
            default: Medium

      - name: gpt-5.4-mini
        label: GPT-5.4-Mini
        notes:
          - "Small, fast, and cost-efficient model for simpler coding tasks."
        context: 272000
        options:
          - name: Reasoning Level
            values: [Low, Medium, High, Extra high]
            default: Medium

      - name: gpt-5.3-codex-spark
        label: GPT-5.3-Codex-Spark
        notes:
          - "Ultra-fast coding model."
        context: 128000
        options:
          - name: Reasoning Level
            values: [Low, Medium, High, Extra high]
            default: High

  - cli: Antigravity
    version: 1.1.20
    last_updated: 2026-08-26
    notes:
      - "Source: live `agy models` on 1.1.20, one `<id><tab><label>` pair per line"
      - "`name` is the raw id `--model` accepts. A rejected id makes agy echo the labels back instead, so ids and labels are not interchangeable on input."
      - "No entry is marked default: agy takes its default from the per-user settings.json `model` field, and the runtime omits `--model` entirely when nothing is selected, so naming one here would override a preference the runtime cannot see."
    models:
      - name: gemini-3.7-flash-high
        label: Gemini 3.7 Flash (High)
      - name: gemini-3.7-flash-medium
        label: Gemini 3.7 Flash (Medium)
      - name: gemini-3.7-flash-low
        label: Gemini 3.7 Flash (Low)
      - name: gemini-3.6-flash-high
        label: Gemini 3.6 Flash (High)
      - name: gemini-3.6-flash-medium
        label: Gemini 3.6 Flash (Medium)
      - name: gemini-3.6-flash-low
        label: Gemini 3.6 Flash (Low)
      - name: gemini-3.5-flash-high
        label: Gemini 3.5 Flash (High)
      - name: gemini-3.5-flash-medium
        label: Gemini 3.5 Flash (Medium)
      - name: gemini-3.5-flash-low
        label: Gemini 3.5 Flash (Low)
      - name: gemini-3.1-pro-high
        label: Gemini 3.1 Pro (High)
      - name: gemini-3.1-pro-low
        label: Gemini 3.1 Pro (Low)
      - name: claude-sonnet-4-6
        label: Claude Sonnet 4.6 (Thinking)
      - name: claude-opus-4-6-thinking
        label: Claude Opus 4.6 (Thinking)
      - name: gpt-oss-120b-medium
        label: GPT-OSS 120B (Medium)

  - cli: Cursor
    version: 2026.08.11-e8db854
    last_updated: 2026-08-26
    notes:
      - "Source: live `cursor-agent models` output, which prints `<id> - <label>` pairs"
      - "`name` is the raw id `cursor-agent --model` accepts, and `label` is the picker-visible text. The dynamic discovery path (`cursor-agent --list-models`) keys models by the same id, so the static fallback and the live catalog now agree."
      - "Superseded the 2026-04-17 label-only listing: Cursor changed its Anthropic id scheme at 4.7 (claude-4.6-opus-high but claude-opus-4-7-low), which no label-derived id can reproduce."
    models:
      - name: auto
        label: Auto
        default: true
      - name: gpt-5.3-codex-low
        label: Codex 5.3 Low
      - name: gpt-5.3-codex-low-fast
        label: Codex 5.3 Low Fast
      - name: gpt-5.3-codex
        label: Codex 5.3
      - name: gpt-5.3-codex-fast
        label: Codex 5.3 Fast
      - name: gpt-5.3-codex-high
        label: Codex 5.3 High
      - name: gpt-5.3-codex-high-fast
        label: Codex 5.3 High Fast
      - name: gpt-5.3-codex-xhigh
        label: Codex 5.3 Extra High
      - name: gpt-5.3-codex-xhigh-fast
        label: Codex 5.3 Extra High Fast
