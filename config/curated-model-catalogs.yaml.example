              - value: max
                label: Max
                description: For difficult problems when quality matters more than speed · higher usage
              - value: ultra
                label: Ultra
                description: For demanding work using multiple agents · highest usage
            semanticTags:
              - reasoning_intensity
            default: medium
        limits:
          contextWindowTokens: 272000
      - default: false
        id: gpt-6-sol
        label: GPT-6-Sol
        limits:
          contextWindowTokens: 272000
        notes:
          - Previous generation workhorse model.
        execution:
          model: gpt-6-sol
        controls:
          - key: codex.reasoning_effort
