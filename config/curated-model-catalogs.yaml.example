  - cli: Copilot
    version: v1.0.31
    last_updated: 2026-04-17
    notes:
      - "Source: Copilot model picker output supplied by user"
    providers:
      - name: OpenAI
        shared_options:
          - name: Reasoning effort
            values:
              - name: Low
                notes:
                  - "Faster responses, less detailed reasoning"
              - name: Medium
                notes:
                  - "Balanced speed and reasoning depth"
              - name: High
                notes:
                  - "More thorough reasoning, slower responses"
            default: Medium
        models:
          - name: GPT-5.4
            default: true

          - name: GPT-5.3-Codex

          - name: GPT-5.2-Codex
            options:
              - name: Reasoning effort
                default: High

          - name: GPT-5.2

          - name: GPT-5.4 mini

          - name: GPT-5 mini

          - name: GPT-4.1
            options: []

      - name: Anthropic
        shared_options:
