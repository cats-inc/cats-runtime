  - cli: Copilot
    version: v1.0.25
    last_updated: 2026-04-14
    notes:
      - "Source: Copilot model picker output supplied by user"
      - "Reasoning options below preserve the picker-visible labels only."
    shared_options:
      - name: Reasoning Level
        values:
          - name: Low
            notes:
              - "Faster responses, less detailed reasoning"
          - name: Medium
            notes:
              - "Balanced speed and reasoning depth"
          - name: High
            notes:
              - "More thorough reasoning, slower responses"
          - name: Extra High
            notes:
              - "Maximum reasoning depth, slowest responses"
        default: Medium
    models:
      - name: GPT-5.4
        default: true

      - name: GPT-5.3-Codex

      - name: GPT-5.2-Codex
        options:
          - name: Reasoning Level
            values: [Low, Medium, High, Extra High]
            default: High

      - name: GPT-5.2
        options:
          - name: Reasoning Level
            values: [Low, Medium, High]
            default: Medium

      - name: GPT-5.1
        options:
          - name: Reasoning Level
            values: [Low, Medium, High]
            default: Medium

      - name: GPT-5.4 mini

      - name: GPT-5 mini
        options:
          - name: Reasoning Level
            values: [Low, Medium, High]
            default: Medium

      - name: GPT-4.1
        options: []

      - name: Claude Sonnet 4.6
        options:
          - name: Reasoning Level
            values: [Low, Medium, High]
            default: Medium

      - name: Claude Sonnet 4.5
        options: []

      - name: Claude Haiku 4.5
        options: []

      - name: Claude Opus 4.6
        options:
          - name: Reasoning Level
            values: [Low, Medium, High]
            default: High

      - name: Claude Opus 4.5
        options: []

      - name: Claude Sonnet 4
        options: []

  - cli: Kilo
    version: v7.2.0
    last_updated: 2026-04-14
    notes:
      - "Source: Kilo model picker output supplied by user."
      - "Entries below preserve picker-visible labels only; runtime maps them to Kilo gateway ids."
    models:
      - name: Kilo Auto Frontier

      - name: Kilo Auto Balanced

      - name: Kilo Auto Free

      - name: "ByteDance Seed: Dola Seed 2.0 Pro (free)"

      - name: "xAI: Grok Code Fast 1 Optimized (free)"

      - name: Elephant (new)

      - name: "Anthropic: Claude Opus 4.6"

      - name: "Anthropic: Claude Sonnet 4.6"

