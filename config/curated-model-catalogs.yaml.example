schema_version: 1

# Draft curator-facing model catalog input.
#
# Purpose:
# - Keep this file human-writable.
# - Fill in only the labels you can actually read from the CLI or UI.
# - Do not translate values into runtime/internal forms.
#
# Runtime normalization is intentionally a later cats-runtime responsibility.
# Inheritance rules:
# - model with no `options` key inherits shared_options in scope
# - use `options: []` to say a model has no options
# - provider shared_options override same-named catalog shared_options
#
# Seed data below was backfilled from:
# - local CLI versions observed on 2026-04-08
# - current cats-runtime static/advanced catalog baselines
# - current local CLI/UI picker output and observed model lists
#
# Treat this file as a starting point to correct, trim, or expand.

catalogs:
  - cli: Claude
    version: 2.1.112
    last_updated: 2026-04-17
    notes:
      - "Source: claude /model picker and /effort output"
    models:
      - name: Opus
        label: Opus 4.7 with 1M context
        notes:
          - Most capable for complex work
        default: true
        context: 1000000
        options:
          - name: Effort
            values:
              - name: Low
                notes:
                  - "Quick, straightforward implementation with minimal overhead"
              - name: Medium
                notes:
                  - "Balanced approach with standard implementation and testing"
              - name: High
                notes:
                  - "Comprehensive implementation with extensive testing and documentation"
              - name: xHigh
                notes:
                  - "Deeper reasoning than high, just below maximum"
              - name: Max
                notes:
                  - "Maximum capability with deepest reasoning"
            default: xHigh

      - name: Sonnet
        label: Sonnet 4.6
        notes:
          - Best for everyday tasks
        options:
          - name: Effort
            values: [Low, Medium, High, Max]
            default: Medium

      - name: Haiku
        label: Haiku 4.5
        notes:
          - Fastest for quick answers
        options: []

  - cli: Codex
    version: 0.121.0
    last_updated: 2026-04-17
    notes:
      - "Source: codex model picker and reasoning level selector"
      - "Context window reported ~258K total"
    shared_options:
      - name: Reasoning Level
        values:
          - name: Low
            notes:
              - "Fast responses with lighter reasoning"
          - name: Medium
            notes:
              - "Balances speed and reasoning depth for everyday tasks"
          - name: High
            notes:
              - "Greater reasoning depth for complex problems"
          - name: Extra high
            notes:
              - "Extra high reasoning depth for complex problems"
        default: Medium
    models:
      - name: gpt-5.4
        label: gpt-5.4
        notes:
          - "Latest frontier agentic coding model."
        default: true

      - name: gpt-5.2-codex
        label: gpt-5.2-codex
        notes:
          - "Frontier agentic coding model."

      - name: gpt-5.1-codex-max
        label: gpt-5.1-codex-max
        notes:
          - "Codex-optimized flagship for deep and fast reasoning."

      - name: gpt-5.4-mini
        label: gpt-5.4-mini
        notes:
          - "Smaller frontier agentic coding model."

      - name: gpt-5.3-codex
        label: gpt-5.3-codex
        notes:
          - "Frontier Codex-optimized agentic coding model."

      - name: gpt-5.3-codex-spark
        label: gpt-5.3-codex-spark
        notes:
          - "Ultra-fast coding model."
        options:
          - name: Reasoning Level
            default: High

      - name: gpt-5.2
        label: gpt-5.2
        notes:
          - "Optimized for professional work and long-running agents."

      - name: gpt-5.1-codex-mini
        label: gpt-5.1-codex-mini
        notes:
          - "Optimized for codex. Cheaper, faster, but less capable."
        options:
          - name: Reasoning Level
            values: [Medium, High]
            default: Medium

  - cli: Antigravity
    version: probe-required
    last_updated: 2026-05-24
    notes:
      - "Source: cats-runtime Phase 0 Antigravity CLI probe notes. Raw agy model IDs are not yet verified."
    models:
      - name: Gemini 3.1 Pro (high)
        label: Gemini 3.1 Pro (high)
        default: true

      - name: Gemini 3.1 Pro (low)
        label: Gemini 3.1 Pro (low)

      - name: Gemini 3 Flash
        label: Gemini 3 Flash

      - name: Claude Sonnet 4.6 (thinking)
        label: Claude Sonnet 4.6 (thinking)

      - name: Claude Opus 4.6 (thinking)
        label: Claude Opus 4.6 (thinking)

      - name: GPT-OSS-120b
        label: GPT-OSS-120b

