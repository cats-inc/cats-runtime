version: 1

# Environments describe isolated execution/login contexts.
# Today cats-runtime supports native and WSL. Docker can fit this shape later.
#
# Supported kinds:
#   native  - run on the host directly (macOS / Linux / Windows)
#   wsl     - run inside a WSL distro (Windows only)
#
# On macOS / Linux all CLI providers usually run natively, so you only need:
#   environments:
#     native:
#       kind: native
# or simply omit the environments block entirely (defaults to native).
#
# WSL distro names must match `wsl -l`.
environments:
  native:
    kind: native
  ubuntu:
    kind: wsl
    distro: Ubuntu

# Routing picks the default execution target for each provider family.
# The instance itself lives under one backend section below.
routing:
  providers:
    claude:
      default_target:
        backend: cli
        instance: native
    codex:
      default_target:
        backend: cli
        instance: native
    gemini:
      default_target:
        backend: cli
        instance: native
    copilot:
      default_target:
        backend: cli
        instance: native
    opencode:
      default_target:
        backend: cli
        instance: native
    auggie:
      default_target:
        backend: cli
        instance: native
    cursor:
      default_target:
        backend: cli
        instance: native
    kiro:
      default_target:
        backend: cli
        instance: native

backends:
  cli:
    # Positive list: only providers listed here are enabled for CLI execution.
    # Any known provider omitted from this block is disabled.
    providers:
      claude:
        instances:
          native:
            environment: native
            command: claude
            runner: auto
            projects_dir: ~/.claude/projects

      codex:
        instances:
          native:
            environment: native
            command: codex
            runner: auto
            sessions_dir: ~/.codex/sessions

      gemini:
        instances:
          native:
            environment: native
            command: gemini
            runner: auto
            sessions_dir: ~/.gemini/tmp

      copilot:
        instances:
          native:
            environment: native
            command: copilot
            runner: auto
            sessions_dir: ~/.copilot/session-state

      opencode:
        instances:
          native:
            environment: native
            command: opencode
            runner: auto
            server:
              host: 127.0.0.1
              port: 4097
              startup_timeout_ms: 10000

      auggie:
        instances:
          native:
            environment: native
            command: auggie
            runner: auto
            sessions_dir: ~/.augment/sessions

      cursor:
        instances:
          native:
            environment: native
            command: cursor-agent
            runner: auto
            chats_dir: ~/.cursor/chats

      kiro:
        instances:
          native:
            environment: native
            command: kiro-cli
            runner: auto
            # db_path defaults:
            #   macOS:       ~/Library/Application Support/kiro-cli/data.sqlite3
            #   Linux / WSL: ~/.local/share/kiro-cli/data.sqlite3
            db_path: ~/Library/Application Support/kiro-cli/data.sqlite3

  # API and local model backends use separate sections on purpose so they do not
  # share the same instance map as CLI providers. Current builds parse these
  # sections for catalog/routing groundwork; execution support lands in upcoming
  # phases.
  #
  # api:
  #   providers:
  #     openai:
  #       instances:
  #         main:
  #           transport: openai
  #           api_key_env: OPENAI_API_KEY
  #           model: gpt-5
  #     claude:
  #       instances:
  #         sonnet:
  #           transport: anthropic
  #           api_key_env: ANTHROPIC_API_KEY
  #           model: claude-sonnet-4-6
  #
  # local:
  #   providers:
  #     ollama:
  #       instances:
  #         local:
  #           transport: ollama
  #           base_url: http://127.0.0.1:11434
  #           model: qwen3:latest
