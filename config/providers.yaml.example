version: 1

# Environments describe isolated execution/login contexts.
# Today cats-runtime supports native and WSL. Docker can fit this shape later.
#
# Supported kinds:
#   native  - run on the host directly (macOS / Linux / Windows)
#   wsl     - run inside a WSL distro (Windows only)
#
# On macOS / Linux all CLI providers usually run natively, so you only need:
#   environments:
#     native:
#       kind: native
# or simply omit the environments block entirely (defaults to native).
#
# WSL distro names must match `wsl -l`.
environments:
  native:
    kind: native
  ubuntu:
    kind: wsl
    distro: Ubuntu

# Routing picks the default execution target for each provider family.
# Provider families use product names (`claude`, `codex`, `gemini`) while
# `transport` uses the vendor API (`anthropic`, `openai`, `google`, `ollama`).
routing:
  providers:
    claude:
      default_target:
        backend: cli
        instance: native
    codex:
      default_target:
        backend: cli
        instance: native
    gemini:
      default_target:
        backend: cli
        instance: native
    copilot:
      default_target:
        backend: cli
        instance: native
    opencode:
      default_target:
        backend: cli
        instance: native
    auggie:
      default_target:
        backend: cli
        instance: native
    pi:
      default_target:
        backend: cli
        instance: native
    cursor:
      default_target:
        backend: cli
        instance: ubuntu
    kiro:
      default_target:
        backend: cli
        instance: ubuntu
    goose:
      default_target:
        backend: cli
        instance: ubuntu
    ollama:
      default_target:
        backend: local
        instance: local
    openclaw:
      default_target:
        backend: agent
        instance: gateway

backends:
  cli:
    # Positive list: only providers listed here are enabled for CLI execution.
    # Any known provider omitted from this block is disabled.
    providers:
      claude:
        instances:
          native:
            environment: native
            command: claude
            runner: auto
            projects_dir: ~/.claude/projects

      codex:
        instances:
          native:
            environment: native
            command: codex
            runner: auto
            sessions_dir: ~/.codex/sessions

      gemini:
        instances:
          native:
            environment: native
            command: gemini
            runner: auto
            sessions_dir: ~/.gemini/tmp

      copilot:
        instances:
          native:
            environment: native
            command: copilot
            runner: auto
            sessions_dir: ~/.copilot/session-state

      opencode:
        instances:
          native:
            environment: native
            command: opencode
            runner: auto
            server:
              host: 127.0.0.1
              port: 4097
              startup_timeout_ms: 10000

      auggie:
        instances:
          native:
            environment: native
            command: auggie
            runner: auto
            sessions_dir: ~/.augment/sessions

      pi:
        instances:
          native:
            environment: native
            command: pi
            runner: auto
            # Pi stores session files under this directory.
            # Session resume uses --session <path> to continue a previous conversation.
            sessions_dir: ~/.pi/agent/sessions

      cursor:
        instances:
          ubuntu:
            environment: ubuntu
            command: cursor-agent
            runner: auto
            chats_dir: ~/.cursor/chats

      kiro:
        instances:
          ubuntu:
            environment: ubuntu
            command: kiro-cli
            runner: auto
            # db_path defaults:
            #   macOS:       ~/Library/Application Support/kiro-cli/data.sqlite3
            #   Linux / WSL: ~/.local/share/kiro-cli/data.sqlite3
            db_path: ~/.local/share/kiro-cli/data.sqlite3

      goose:
        instances:
          ubuntu:
            environment: ubuntu
            command: goose
            runner: auto

  api:
    providers:
      claude:
        default_instance: sonnet
        transport: anthropic
        api_key_env: ANTHROPIC_API_KEY
        instances:
          sonnet:
            # As of 2026-03-16, Anthropic's documented balanced pay-as-you-go
            # model is Claude Sonnet 4.
            model: claude-sonnet-4-20250514

      codex:
        default_instance: main
        transport: openai
        api_key_env: OPENAI_API_KEY
        instances:
          main:
            # As of 2026-03-16, OpenAI's latest documented Codex model is GPT-5.2-Codex.
            model: gpt-5.2-codex

      gemini:
        default_instance: flash
        transport: google
        api_key_env: GEMINI_API_KEY
        instances:
          flash:
            # As of 2026-03-16, Google's documented balanced Gemini 3 API model
            # is Gemini 3 Flash Preview.
            model: gemini-3-flash-preview

  local:
    providers:
      ollama:
        instances:
          local:
            transport: ollama
            base_url: http://127.0.0.1:11434
            # Qwen2.5 Coder 7B fits comfortably on an RTX 4060 8GB and remains
            # one of the strongest Ollama-hosted coding-specialized options.
            model: qwen2.5-coder:7b

  agent:
    providers:
      openclaw:
        default_instance: gateway
        transport: openclaw_gateway
        # Keep these in env vars because OpenClaw deployments are usually
        # environment-specific.
        url_env: OPENCLAW_URL
        auth_token_env: OPENCLAW_TOKEN
        client_id: cats-runtime
        instances:
          gateway:
            model: openclaw-coder

      # An Agent SDK bridge can also front an existing product family such as
      # Claude. Keep CLI/API/agent routing independent; this block only makes
      # the agent-backed target available as `agent/sdk`.
      claude:
        default_instance: sdk
        transport: agent_sdk_bridge
        base_url_env: AGENT_SDK_URL
        auth_token_env: AGENT_SDK_TOKEN
        instances:
          sdk:
            model: claude-sonnet-4-20250514
