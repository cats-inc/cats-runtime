version: 1

# Environments describe isolated execution/login contexts.
# Today cats-runtime supports native and WSL. Docker can fit this shape later.
#
# Supported kinds:
#   native  — run on the host directly (macOS / Linux / Windows)
#   wsl     — run inside a WSL distro (Windows only)
#   (docker — planned; specify container name, image is not needed)
#
# On macOS / Linux all providers run natively, so you only need:
#   environments:
#     native:
#       kind: native
# or simply omit the environments block entirely (defaults to native).
#
# WSL: distro names must be unique (as shown by `wsl -l`).
# To run two Ubuntu environments, import the same image under different names:
#   wsl --import Ubuntu-Dev D:\wsl\Ubuntu-Dev D:\exports\ubuntu.tar
# Then reference each by its distinct distro name below.
#
# File-backed provider paths are resolved on the host. On Windows, if you add a
# WSL-backed file provider (Claude/Codex/Copilot/Gemini/Auggie), use a
# host-accessible path such as \\wsl$\Ubuntu\home\user\... instead of ~/.xxx.
environments:
  native:
    kind: native
  ubuntu:
    kind: wsl
    distro: Ubuntu

# Positive-list: only providers listed below are enabled.
# Any known provider omitted from this block is automatically disabled
# (attempting to create a session for it will return an error).
# To enable only a subset, simply remove the providers you don't need.
providers:
  claude:
    default_instance: native
    instances:
      native:
        environment: native
        command: claude
        runner: auto
        projects_dir: ~/.claude/projects

  codex:
    default_instance: native
    instances:
      native:
        environment: native
        command: codex
        runner: auto
        sessions_dir: ~/.codex/sessions

  gemini:
    default_instance: native
    instances:
      native:
        environment: native
        command: gemini
        runner: auto
        sessions_dir: ~/.gemini/tmp

  copilot:
    default_instance: native
    instances:
      native:
        environment: native
        command: copilot
        runner: auto
        sessions_dir: ~/.copilot/session-state

  opencode:
    default_instance: native
    instances:
      native:
        environment: native
        command: opencode
        runner: auto
        server:
          host: 127.0.0.1
          port: 4097
          startup_timeout_ms: 10000

  auggie:
    default_instance: native
    instances:
      native:
        environment: native
        command: auggie
        runner: auto
        sessions_dir: ~/.augment/sessions

  cursor:
    default_instance: ubuntu
    instances:
      ubuntu:
        environment: ubuntu
        command: cursor-agent
        runner: auto
        chats_dir: ~/.cursor/chats

  kiro:
    default_instance: ubuntu
    instances:
      ubuntu:
        environment: ubuntu
        command: kiro-cli
        runner: auto
        # db_path defaults:
        #   macOS:       ~/Library/Application Support/kiro-cli/data.sqlite3
        #   Linux / WSL: ~/.local/share/kiro-cli/data.sqlite3
        db_path: ~/.local/share/kiro-cli/data.sqlite3
