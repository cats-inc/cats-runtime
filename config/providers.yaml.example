version: 1

# Environments describe isolated execution/login contexts.
#
# Supported kinds:
#   native  - run on the host directly (macOS / Linux / Windows)
#   wsl     - run inside a WSL distro (Windows only)
#   docker  - run inside a named Docker container
#
# On macOS / Linux all CLI providers usually run natively, so you only need:
#   environments:
#     native:
#       kind: native
# or simply omit the environments block entirely (defaults to native).
#
# WSL distro names must match `wsl -l`.
# Docker container names must match a running `docker ps` container.
environments:
  native:
    kind: native
  ubuntu:
    kind: wsl
    distro: Ubuntu
  docker-dev:
    kind: docker
    container: cats-cli-dev

# Routing picks the default execution target for each provider family.
# Provider families use product names (`claude`, `codex`, `antigravity`) while
# `transport` uses the vendor API (`anthropic`, `openai`, `google`, `ollama`).
routing:
  providers:
    claude:
      default_target:
        backend: cli
        instance: native
    codex:
      default_target:
        backend: cli
        instance: native
    antigravity:
      default_target:
        backend: cli
        instance: native
    cursor:
      default_target:
        backend: cli
        instance: native
    copilot:
      default_target:
        backend: cli
        instance: native
    opencode:
      default_target:
        backend: cli
        instance: native
    kilo:
      default_target:
        backend: cli
        instance: native
    goose:
      default_target:
        backend: cli
        instance: native
    pi:
      default_target:
        backend: cli
        instance: native
    auggie:
      default_target:
        backend: cli
        instance: native
    junie:
      default_target:
        backend: cli
        instance: native
    kiro:
      default_target:
        backend: cli
        instance: native
    grok:
      default_target:
        backend: cli
        instance: native
    ollama:
      default_target:
        backend: local
        instance: local
    openclaw:
      default_target:
        backend: agent
        instance: gateway

backends:
  cli:
    # CLI targets are compatibility-probed by cats-runtime during setup,
    # diagnostics, and execution priming. Degraded or failed probes write
    # replay-friendly evidence bundles under <dataDir>/compatibility/ and the
    # cached summary is surfaced via /diagnostics/providers and /providers/config.
    # /diagnostics/providers?probe=live validates runtime execution flags for
    # provider families that define a safe live probe; force=1 refreshes stale
    # cache entries after installs, upgrades, or PATH/auth changes.
    # /providers/config also exposes runtime-owned static install metadata, and
    # /diagnostics/providers adds machine-readable setup status/remediation such
    # as missing install, missing prerequisites, missing PATH persistence, npm
    # prefix drift, auth required, or unsupported version.
    # Positive list: only providers listed here are enabled for CLI execution.
    # Any known provider omitted from this block is disabled.
    providers:
      claude:
        instances:
          native:
            environment: native
            command: claude
            runner: auto
            projects_dir: ~/.claude/projects
          # Local desktop instance that starts Claude Code with the Claude in
          # Chrome integration enabled. Requires Chrome/Edge, the Claude in
          # Chrome extension, and a completed local extension connection.
          # This must stay native because the Chrome extension bridge is a
          # desktop browser integration, not a WSL/Docker runtime. It is also
          # an OS-level singleton: one active Cats claude --chrome worker can
          # collide with another Cats session, Claude Desktop, or a manual
          # Claude Code session that is already attached to Chrome.
          native-chrome:
            environment: native
            command: claude
            launch:
              # Singleton resource id, must be '<namespace>:<resource>'. Only one
              # active Cats session per id is allowed at a time. Use the same id
              # on any instance that competes for the same OS-level resource
              # (Chrome extension, named pipe, exclusive device, etc.).
              singleton: claude:chrome
              args:
                - --chrome
            runner: auto
            projects_dir: ~/.claude/projects
          # Docker-backed instance example: runs claude inside a Docker container.
          # Requires the container to be running (`docker start cats-cli-dev`).
          # docker:
          #   environment: docker-dev
          #   command: claude
          #   runner: auto
          #   projects_dir: ~/.claude/projects

      codex:
        instances:
          native:
            environment: native
            command: codex
            runner: auto
            sessions_dir: ~/.codex/sessions

      antigravity:
        instances:
          native:
            environment: native
            command: agy
            runner: auto
            timeout_ms: 120000

      cursor:
        instances:
          native:
            environment: native
            command: cursor-agent
            runner: auto
            chats_dir: ~/.cursor/chats

      copilot:
        instances:
          native:
            environment: native
            command: copilot
            runner: auto
            sessions_dir: ~/.copilot/session-state
            timeout_ms: 60000

      opencode:
        instances:
          native:
            environment: native
            command: opencode
            runner: auto
            server:
              host: 127.0.0.1
              port: 4097
              startup_timeout_ms: 10000

      kilo:
        instances:
          native:
            environment: native
            command: kilo
            runner: auto
            server:
              host: 127.0.0.1
              port: 4313
              startup_timeout_ms: 10000

      goose:
        instances:
          native:
            environment: native
            command: goose
            runner: auto

      pi:
        instances:
          native:
            environment: native
            command: pi
            runner: auto
            # Pi stores session files under this directory.
            # Session resume uses --session <path> to continue a previous conversation.
            sessions_dir: ~/.pi/agent/sessions

      auggie:
        instances:
          native:
            environment: native
            command: auggie
            runner: auto
            sessions_dir: ~/.augment/sessions

      junie:
        instances:
          native:
            environment: native
            command: junie
            runner: auto

      kiro:
        instances:
          native:
            environment: native
            command: kiro-cli
            runner: auto
            # db_path defaults:
            #   Windows: ~/AppData/Local/kiro-cli/data.sqlite3
            #   macOS:   ~/Library/Application Support/kiro-cli/data.sqlite3
            #   Linux:   ~/.local/share/kiro-cli/data.sqlite3

      grok:
        instances:
          native:
            environment: native
            command: grok
            runner: auto

  api:
    providers:
      claude:
        default_instance: sonnet
        transport: anthropic
        api_key_env: ANTHROPIC_API_KEY
        instances:
          sonnet:
            # As of 2026-03-16, Anthropic's documented balanced pay-as-you-go
            # model is Claude Sonnet 4.
            model: claude-sonnet-4-20250514

      codex:
        default_instance: main
        transport: openai
        api_key_env: OPENAI_API_KEY
        instances:
          main:
            # As of 2026-03-16, OpenAI's latest documented Codex model is GPT-5.2-Codex.
            model: gpt-5.2-codex

      gemini:
        default_instance: flash
        transport: google
        api_key_env: GEMINI_API_KEY
        instances:
          flash:
            # As of 2026-03-16, Google's documented balanced Gemini 3 API model
            # is Gemini 3 Flash Preview.
            model: gemini-3-flash-preview

  local:
    providers:
      ollama:
        instances:
          local:
            transport: ollama
            base_url: http://127.0.0.1:11434
            # Qwen2.5 Coder 7B fits comfortably on an RTX 4060 8GB and remains
            # one of the strongest Ollama-hosted coding-specialized options.
            model: qwen2.5-coder:7b

  agent:
    providers:
      openclaw:
        default_instance: gateway
        transport: openclaw_gateway
        # Keep these in env vars because OpenClaw deployments are usually
        # environment-specific.
        url_env: OPENCLAW_URL
        auth_token_env: OPENCLAW_TOKEN
        client_id: gateway-client
        instances:
          gateway:
            model: openai-codex/gpt-5.4

      # An Agent SDK bridge can also front an existing product family such as
      # Claude. Keep CLI/API/agent routing independent; this block only makes
      # the agent-backed target available as `agent/sdk`.
      claude:
        default_instance: sdk
        transport: agent_sdk_bridge
        base_url_env: AGENT_SDK_URL
        auth_token_env: AGENT_SDK_TOKEN
        instances:
          sdk:
            model: claude-sonnet-4-20250514
