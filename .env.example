CATS_RUNTIME_API_KEY=
CATS_RUNTIME_HOST=127.0.0.1
CATS_RUNTIME_PORT=3110
# Defaults to ~/.cats/runtime/{config,data,sessions} when blank.
CATS_RUNTIME_DIR=
# Fine-grained overrides; leave blank unless you need to diverge from CATS_RUNTIME_DIR.
CATS_RUNTIME_DATA_DIR=
CATS_RUNTIME_SESSION_BASE_DIR=
CATS_RUNTIME_CONFIG_PATH=
CATS_RUNTIME_MAX_SESSIONS=20

# Background discovery and worker lifecycle.
CATS_RUNTIME_NATIVE_DISCOVERY_INTERVAL_MS=5000
CATS_RUNTIME_WSL_DISCOVERY_POLICY=if_running
CATS_RUNTIME_DOCKER_DISCOVERY_POLICY=if_running
CATS_RUNTIME_EXTERNAL_SESSION_LIVE_WINDOW_MS=15000
CATS_RUNTIME_SPAWN_RETRIES=1
CATS_RUNTIME_SPAWN_TIMEOUT_MS=30000

# API/local provider credentials. Keep secrets in your real `.env`, not in
# `~/.cats/runtime/config/providers.yaml`.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
GEMINI_API_KEY=
OPENCLAW_URL=ws://127.0.0.1:18789/ws
OPENCLAW_TOKEN=
AGENT_SDK_URL=http://127.0.0.1:8082
AGENT_SDK_TOKEN=

# Additive runtime metering and execution guardrails.
# Leave blank to disable per-session token warn/block thresholds.
CATS_RUNTIME_GUARDRAIL_SESSION_TOTAL_TOKENS_WARN=
CATS_RUNTIME_GUARDRAIL_SESSION_TOTAL_TOKENS_BLOCK=
# Default cooldown applied when a provider reports or implies rate limiting.
CATS_RUNTIME_RATE_LIMIT_COOLDOWN_MS=60000

# LAN peer discovery and execution routing (default-off).
CATS_RUNTIME_PEERS_ENABLED=false
CATS_RUNTIME_PEER_ID=
CATS_RUNTIME_PEER_NAME=
CATS_RUNTIME_PEER_ADVERTISE_URL=
CATS_RUNTIME_PEER_ADVERTISE_HOST=
CATS_RUNTIME_PEER_ADVERTISE_PORT=
CATS_RUNTIME_PEER_STALE_TTL_MS=30000
CATS_RUNTIME_PEER_PRUNE_INTERVAL_MS=10000
CATS_RUNTIME_PEER_ADVERTISE_INTERVAL_MS=15000
CATS_RUNTIME_PEER_MAX_TARGETS=16
CATS_RUNTIME_PEER_REQUEST_TIMEOUT_MS=120000
CATS_RUNTIME_PEER_AUTH_FAILURE_WINDOW_MS=60000
CATS_RUNTIME_PEER_AUTH_FAILURE_LIMIT=5
CATS_RUNTIME_PEER_MAX_INBOUND_EXECUTIONS=8
CATS_RUNTIME_PEER_MAX_INBOUND_EXECUTIONS_PER_PEER=2
CATS_RUNTIME_PEER_REPLAY_WINDOW_MS=120000
CATS_RUNTIME_PEER_REPLAY_NONCE_TTL_MS=120000
CATS_RUNTIME_PEER_MAX_REPLAY_NONCES_PER_CALLER=64
CATS_RUNTIME_PEER_LIMIT_OVERRIDES=
CATS_RUNTIME_PEER_ALLOW_HEURISTIC_ROUTING=false
# Shared secret for runtime-to-runtime POST /peer/executions auth.
CATS_RUNTIME_PEER_SHARED_SECRET=
# Comma-separated list or JSON array of additional inbound-only secrets during rotation.
CATS_RUNTIME_PEER_SHARED_SECRETS=
# Comma-separated list or JSON array.
CATS_RUNTIME_PEER_TRUSTED_IDS=
CATS_RUNTIME_PEER_REJECTED_IDS=
# JSON array of static peer seeds. Example:
# [{"peerId":"lab-peer","displayName":"lab-peer","advertisedUrl":"http://10.0.0.9:3110","providers":["codex"]}]
CATS_RUNTIME_PEER_STATIC_PEERS=

# Show session details panel in the dashboard chat view (default-off).
CATS_RUNTIME_DASHBOARD_SHOW_SESSION_DETAILS=true

# Optional real browser driver support (default-off).
CATS_RUNTIME_BROWSER_PLAYWRIGHT_ENABLED=false
CATS_RUNTIME_BROWSER_PLAYWRIGHT_EXECUTABLE_PATH=
CATS_RUNTIME_BROWSER_PLAYWRIGHT_CHANNEL=
CATS_RUNTIME_BROWSER_PLAYWRIGHT_HEADLESS=true
# Comma-separated launch args. Example: --disable-dev-shm-usage,--no-sandbox
CATS_RUNTIME_BROWSER_PLAYWRIGHT_ARGS=
CATS_RUNTIME_BROWSER_PLAYWRIGHT_NAVIGATION_TIMEOUT_MS=30000

# Optional MCP stdio proxy overrides for `cats-runtime-mcp`.
CATS_RUNTIME_MCP_PROXY_URL=
CATS_RUNTIME_MCP_PROXY_TIMEOUT_MS=1800000

# Optional host-managed startup overrides.
CATS_RUNTIME_STARTUP_MODE=
CATS_RUNTIME_MANAGED_BY=
CATS_RUNTIME_READY_OUTPUT=

# Provider-independent runtime defaults.
AUGGIE_MAX_TURNS=50
PWSH_PATH=C:\Program Files\PowerShell\7\pwsh.exe

# Optional autostart helper overrides.
# Use these only when you need to customize launchd/systemd user-service setup.
# Absolute Node.js binary path for managed autostart helpers (launchd/systemd)
# when the service manager does not inherit your shell PATH.
CATS_RUNTIME_NODE_BIN=
CATS_RUNTIME_LAUNCHD_LABEL=
CATS_RUNTIME_LAUNCHD_PLIST_DIR=
CATS_RUNTIME_LOG_DIR=
CATS_RUNTIME_SUPPORT_DIR=
CATS_RUNTIME_SYSTEMD_SERVICE_NAME=
CATS_RUNTIME_SYSTEMD_UNIT_DIR=

# Provider CLI paths, runners, discovery storage, and per-provider runtimes can
# still be overridden through legacy env vars, but new installs should prefer
# ~/.cats/runtime/config/providers.yaml so one provider can expose multiple instances.
