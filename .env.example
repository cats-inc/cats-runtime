# cats-runtime local configuration
# Copy to `.env` for local development. Do not commit `.env`.

# Listener
CATS_RUNTIME_HOST=127.0.0.1
CATS_RUNTIME_PORT=3110

# Optional inbound auth for clients calling cats-runtime.
CATS_RUNTIME_API_KEY=

# Runtime storage and limits
CATS_RUNTIME_DATA_DIR=
CATS_RUNTIME_SESSION_BASE_DIR=
CATS_RUNTIME_MAX_SESSIONS=10
CATS_RUNTIME_NATIVE_DISCOVERY_INTERVAL_MS=5000
CATS_RUNTIME_EXTERNAL_SESSION_LIVE_WINDOW_MS=15000

# Optional provider command overrides
AUGGIE_PATH=auggie
CLAUDE_PATH=claude
CODEX_PATH=codex
GEMINI_PATH=gemini
COPILOT_PATH=copilot
CURSOR_PATH=cursor-agent
KIRO_PATH=kiro-cli
OPENCODE_PATH=opencode

# Runtime environments: native | wsl
# All provider CLIs can point at executables installed inside a WSL distro.
# *_RUNTIME_DISTRO is only used when the matching *_RUNTIME is set to wsl.
# Leave these unset to use platform defaults:
# - Cursor / Kiro on Windows: wsl
# - Everyone else, plus all providers on macOS/Linux: native
AUGGIE_RUNTIME=native
AUGGIE_RUNTIME_DISTRO=Ubuntu
CLAUDE_RUNTIME=native
CLAUDE_RUNTIME_DISTRO=Ubuntu
CODEX_RUNTIME=native
CODEX_RUNTIME_DISTRO=Ubuntu
GEMINI_RUNTIME=native
GEMINI_RUNTIME_DISTRO=Ubuntu
COPILOT_RUNTIME=native
COPILOT_RUNTIME_DISTRO=Ubuntu
CURSOR_RUNTIME=wsl
CURSOR_RUNTIME_DISTRO=Ubuntu
KIRO_RUNTIME=wsl
KIRO_RUNTIME_DISTRO=Ubuntu
OPENCODE_RUNTIME=native
OPENCODE_RUNTIME_DISTRO=Ubuntu

# Provider runners: auto | shell | direct | cmd | pwsh | powershell
AUGGIE_RUNNER=auto
CLAUDE_RUNNER=auto
CODEX_RUNNER=auto
GEMINI_RUNNER=auto
COPILOT_RUNNER=auto
CURSOR_RUNNER=auto
KIRO_RUNNER=auto
OPENCODE_RUNNER=auto

# Optional explicit runner executables. These are only used when the matching
# *_RUNNER requires them, or when auto selects that runner.
AUGGIE_RUNNER_PATH=
CLAUDE_RUNNER_PATH=
CODEX_RUNNER_PATH=
GEMINI_RUNNER_PATH=
COPILOT_RUNNER_PATH=
CURSOR_RUNNER_PATH=
KIRO_RUNNER_PATH=
OPENCODE_RUNNER_PATH=

# Optional global fallback for pwsh-based runners.
PWSH_PATH=C:\Program Files\PowerShell\7\pwsh.exe

# Optional provider state locations
AUGGIE_SESSIONS_DIR=~/.augment/sessions
CLAUDE_PROJECTS_DIR=
CODEX_SESSIONS_DIR=
GEMINI_SESSIONS_DIR=
COPILOT_SESSIONS_DIR=
CURSOR_CHATS_DIR=~/.cursor/chats
KIRO_DB_PATH=~/.local/share/kiro-cli/data.sqlite3

# Auggie print-mode turn budget per runtime message.
AUGGIE_MAX_TURNS=10

# Optional OpenCode sidecar settings
OPENCODE_SERVER_HOST=127.0.0.1
OPENCODE_SERVER_PORT=4097
OPENCODE_SERVER_STARTUP_TIMEOUT_MS=10000
