CATS_RUNTIME_API_KEY=
CATS_RUNTIME_HOST=127.0.0.1
CATS_RUNTIME_PORT=3110
CATS_RUNTIME_DATA_DIR=
CATS_RUNTIME_SESSION_BASE_DIR=
CATS_RUNTIME_MAX_SESSIONS=10

# Provider CLI paths
# On Windows, if a PowerShell runner cannot resolve Copilot from PATH reliably,
# set COPILOT_PATH to the full copilot.cmd shim path instead.
# Cursor and Kiro run through WSL on Windows by default, so
# CURSOR_PATH / KIRO_PATH should be the executable name/path visible inside that distro.
CLAUDE_PATH=claude
CODEX_PATH=codex
GEMINI_PATH=gemini
COPILOT_PATH=copilot
OPENCODE_PATH=opencode
AUGGIE_PATH=auggie
CURSOR_PATH=cursor-agent
KIRO_PATH=kiro-cli

# Runtime environments: native | wsl
# All provider CLIs can point at executables installed inside a WSL distro.
# *_RUNTIME_DISTRO is only used when the matching *_RUNTIME is set to wsl.
# Leave these unset to use platform defaults:
# - Cursor / Kiro on Windows: wsl
# - Everyone else, plus all providers on macOS/Linux: native
CLAUDE_RUNTIME=native
CLAUDE_RUNTIME_DISTRO=Ubuntu
CODEX_RUNTIME=native
CODEX_RUNTIME_DISTRO=Ubuntu
GEMINI_RUNTIME=native
GEMINI_RUNTIME_DISTRO=Ubuntu
COPILOT_RUNTIME=native
COPILOT_RUNTIME_DISTRO=Ubuntu
OPENCODE_RUNTIME=native
OPENCODE_RUNTIME_DISTRO=Ubuntu
AUGGIE_RUNTIME=native
AUGGIE_RUNTIME_DISTRO=Ubuntu
CURSOR_RUNTIME=wsl
CURSOR_RUNTIME_DISTRO=Ubuntu
KIRO_RUNTIME=wsl
KIRO_RUNTIME_DISTRO=Ubuntu

# Provider runners: auto | shell | direct | cmd | pwsh | powershell
# On Windows, COPILOT_RUNNER=auto defaults to pwsh because cmd/copilot.cmd
# can return an empty prompt-mode response in some environments.
CLAUDE_RUNNER=auto
CODEX_RUNNER=auto
GEMINI_RUNNER=auto
COPILOT_RUNNER=auto
OPENCODE_RUNNER=auto
AUGGIE_RUNNER=auto
CURSOR_RUNNER=auto
KIRO_RUNNER=auto

# Optional explicit runner executables. These are only used when the matching
# *_RUNNER requires them, or when auto selects that runner.
CLAUDE_RUNNER_PATH=
CODEX_RUNNER_PATH=
GEMINI_RUNNER_PATH=
COPILOT_RUNNER_PATH=
OPENCODE_RUNNER_PATH=
AUGGIE_RUNNER_PATH=
CURSOR_RUNNER_PATH=
KIRO_RUNNER_PATH=

# Optional global fallback for pwsh-based runners.
PWSH_PATH=C:\Program Files\PowerShell\7\pwsh.exe

CLAUDE_PROJECTS_DIR=
CODEX_SESSIONS_DIR=
GEMINI_SESSIONS_DIR=
COPILOT_SESSIONS_DIR=
# OpenCode launches a local sidecar server on demand. These defaults match the
# cats-runtime config helpers and are usually fine as-is.
OPENCODE_SERVER_HOST=127.0.0.1
OPENCODE_SERVER_PORT=4097
OPENCODE_SERVER_STARTUP_TIMEOUT_MS=10000
# Auggie saved sessions default to ~/.augment/sessions.
AUGGIE_SESSIONS_DIR=~/.augment/sessions
# Cursor native chats default to ~/.cursor/chats on every platform.
CURSOR_CHATS_DIR=~/.cursor/chats
# Kiro DB defaults:
# - macOS: ~/Library/Application Support/kiro-cli/data.sqlite3
# - Linux / WSL: ~/.local/share/kiro-cli/data.sqlite3
KIRO_DB_PATH=~/.local/share/kiro-cli/data.sqlite3

# Auggie print-mode turn budget per runtime message.
AUGGIE_MAX_TURNS=50

# Poll native Cursor/Kiro storage for externally-created sessions.
# Set to 0 to disable periodic rescans.
CATS_RUNTIME_NATIVE_DISCOVERY_INTERVAL_MS=5000

# Control whether background Cursor/Kiro discovery may start WSL on Windows.
# always | if_running | manual_only
CATS_RUNTIME_WSL_DISCOVERY_POLICY=always

# Treat recently updated discovered transcripts as externally active/observe-only
# for this many milliseconds.
CATS_RUNTIME_EXTERNAL_SESSION_LIVE_WINDOW_MS=15000
