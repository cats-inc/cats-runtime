CATS_RUNTIME_API_KEY=
CATS_RUNTIME_HOST=127.0.0.1
CATS_RUNTIME_PORT=3110
CATS_RUNTIME_DATA_DIR=
CATS_RUNTIME_SESSION_BASE_DIR=
CATS_RUNTIME_CONFIG_PATH=config/providers.yaml
CATS_RUNTIME_MAX_SESSIONS=20

# Background discovery and worker lifecycle.
CATS_RUNTIME_NATIVE_DISCOVERY_INTERVAL_MS=5000
CATS_RUNTIME_WSL_DISCOVERY_POLICY=if_running
CATS_RUNTIME_DOCKER_DISCOVERY_POLICY=if_running
CATS_RUNTIME_EXTERNAL_SESSION_LIVE_WINDOW_MS=15000
CATS_RUNTIME_SPAWN_RETRIES=1
CATS_RUNTIME_SPAWN_TIMEOUT_MS=30000

# Additive runtime metering and execution guardrails.
# Leave blank to disable per-session token warn/block thresholds.
CATS_RUNTIME_GUARDRAIL_SESSION_TOTAL_TOKENS_WARN=
CATS_RUNTIME_GUARDRAIL_SESSION_TOTAL_TOKENS_BLOCK=
# Default cooldown applied when a provider reports or implies rate limiting.
CATS_RUNTIME_RATE_LIMIT_COOLDOWN_MS=60000

# Provider-independent runtime defaults.
AUGGIE_MAX_TURNS=50
PWSH_PATH=C:\Program Files\PowerShell\7\pwsh.exe

# Provider CLI paths, runners, discovery storage, and per-provider runtimes can
# still be overridden through legacy env vars, but new installs should prefer
# config/providers.yaml so one provider can expose multiple instances.
